# Django Environment Variables Template
# Copy this file to .env and fill in your own values
# NEVER commit .env to version control!

# Django settings module
# Options: config.settings.development, config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.development

# Secret key for cryptographic signing
# Generate a new one: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-secret-key-here

# Debug mode (True/False)
# ALWAYS set to False in production!
DEBUG=True

# For production deployment, also set:
# ALLOWED_HOSTS=your-domain.com,www.your-domain.com
